                    height: root.mp4-compatibility == "Custom" ? 134px : 68px;
                    VerticalLayout {
                        padding: 6px; spacing: 3px;
                        HorizontalLayout { height: 28px; spacing: 5px; Tf2Label { width: 105px; text: "COMPATIBILITY"; } ComboBox { height: 28px; model: ["DaVinci Resolve / Universal", "Maximum Color Quality", "Custom"]; current-value <=> root.mp4-compatibility; } }
                        if root.mp4-compatibility != "Custom" : HorizontalLayout { height: 28px; spacing: 5px; Tf2Label { width: 105px; text: "AUDIO"; } ComboBox { width: 75px; height: 28px; model: ["AAC"]; current-value <=> root.mp4-audio-codec; } ComboBox { width: 75px; height: 28px; model: ["192", "256", "320"]; current-value <=> root.mp4-audio-bitrate; } Tf2Body { text: "kbps"; color: Tf2Colors.muted; vertical-alignment: center; } }
                        if root.mp4-compatibility == "Custom" : GridLayout {
                            spacing: 3px;
                            Row { Tf2Label { width: 90px; text: "CODEC"; } ComboBox { height: 27px; model: ["H.264 / libx264"]; current-value <=> root.mp4-video-codec; } Tf2Label { width: 72px; text: "PIXEL"; } ComboBox { width: 115px; height: 27px; model: ["yuv420p", "yuv422p", "yuv444p"]; current-value <=> root.mp4-pixel-format; } }
                            Row { Tf2Label { width: 90px; text: "PROFILE"; } if root.mp4-pixel-format == "yuv420p" : ComboBox { height: 27px; model: ["High"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv422p" : ComboBox { height: 27px; model: ["High 4:2:2"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv444p" : ComboBox { height: 27px; model: ["High 4:4:4 Predictive"]; current-value <=> root.mp4-h264-profile; } Tf2Label { width: 72px; text: "CRF"; } SpinBox { width: 115px; height: 27px; value <=> root.mp4-crf; minimum: 0; maximum: 35; } }
                            Row { Tf2Label { width: 90px; text: "PRESET"; } ComboBox { height: 27px; model: ["veryfast", "faster", "fast", "medium", "slow", "slower"]; current-value <=> root.mp4-encoder-preset; } Tf2Label { width: 72px; text: "AUDIO"; } ComboBox { width: 55px; height: 27px; model: ["AAC"]; current-value <=> root.mp4-audio-codec; } ComboBox { width: 60px; height: 27px; model: ["192", "256", "320"]; current-value <=> root.mp4-audio-bitrate; } Tf2Body { width: 35px; text: "kbps"; color: Tf2Colors.muted; vertical-alignment: center; } }
                        }
                    }
                }
                if root.recording-settings-section == 2 && root.recording-format == "AVI - Raw" : Tf2Panel {
                    height: 68px;
                    GridLayout {
                        padding: 6px; spacing: 3px;
                        Row { Tf2Label { width: 105px; text: "AVI CODEC"; } ComboBox { height: 28px; model: ["Original HLAE Raw", "FFV1 Lossless", "HuffYUV Lossless"]; current-value <=> root.avi-video-codec; } }
                        Row { Tf2Label { width: 105px; text: "PIXEL FORMAT"; } if root.avi-video-codec == "Original HLAE Raw" : ComboBox { height: 28px; model: ["HLAE Native"]; current-value <=> root.avi-pixel-format; } if root.avi-video-codec == "FFV1 Lossless" : ComboBox { height: 28px; model: ["bgr0", "yuv422p", "yuv444p"]; current-value <=> root.avi-pixel-format; } if root.avi-video-codec == "HuffYUV Lossless" : ComboBox { height: 28px; model: ["rgb24", "yuv422p"]; current-value <=> root.avi-pixel-format; } }
                    }

    private property <bool> compact: self.width <= 1220px || self.height <= 700px;
    private property <bool> compact-nav-open: false;
    private property <bool> candidate-filters-open: false;
    private property <bool> advanced-encoding-open: false;
    private property <int> recording-settings-section: 0;
    private property <length> recording-advanced-panel-height: !root.advanced-encoding-open ? 44px : (root.mp4-compatibility == "Custom" && (root.recording-format == "MP4 - Standard" || root.recording-format == "MP4 - Compatible") ? (root.compact ? 178px : 166px) : ((root.recording-format == "MP4 - Standard" || root.recording-format == "MP4 - Compatible") ? (root.compact ? 106px : 120px) : (root.recording-format == "AVI - Raw" ? (root.compact ? 106px : 120px) : (root.recording-format == "MOV - DNxHR" ? (root.compact ? 74px : 82px) : 44px))));

    Rectangle {
        width: root.width; height: root.height;
        dismiss-area := TouchArea {
            dismiss-focus := FocusScope { enabled: true; }
            clicked => { dismiss-focus.focus(); }
        }
        AppHeader { x: 0px; y: 0px; width: root.width; page: root.selected-page; compact: root.compact; has-export: root.has-export; frame-debug: root.frame-debug; recording-save-status: root.recording-save-status; background-process-status: root.background-process-status; background-process-active: root.background-process-active; menu-open <=> root.compact-nav-open; navigate(page) => { root.selected-page = page; root.compact-nav-open = false; } }

        if root.compact && root.compact-nav-open : Rectangle {
            x: 0px; y: 64px; width: root.width; height: 48px; background: Tf2Colors.header;
            HorizontalLayout {
                padding-left: 10px; padding-right: 10px; padding-top: 5px; padding-bottom: 5px; spacing: 5px;
                Tf2Button { text: "PARSE"; enabled: root.selected-page != 0; clicked => { root.selected-page = 0; root.compact-nav-open = false; } }
                Tf2Button { text: "CANDIDATES"; enabled: root.has-export && root.selected-page != 1; clicked => { root.selected-page = 1; root.compact-nav-open = false; } }
                Tf2Button { text: "SETTINGS"; enabled: root.has-export && root.selected-page != 2; clicked => { root.selected-page = 2; root.compact-nav-open = false; } }
                Tf2Button { text: "LOGS"; enabled: root.selected-page != 3; clicked => { root.selected-page = 3; root.compact-nav-open = false; } }
            }
        }

        if root.selected-page == 0 && !root.compact : VerticalLayout {
            x: 0px; y: 118px; width: root.width; height: root.height - self.y;
            padding: 16px; spacing: 9px;
            Tf2Panel {
                height: 128px; background: root.demo-drop-active ? #263b49 : Tf2Colors.panel-dark; border-color: (root.demo-drop-active || drop-touch.has-hover) ? Tf2Colors.blu-hover : Tf2Colors.border;
                VerticalLayout {
                    padding: 12px; spacing: 5px;
                    Text { text: root.demo-drop-active ? "READY TO ADD DEMOS" : "DROP DEMOS HERE"; color: root.demo-drop-active ? Tf2Colors.blu-hover : Tf2Colors.cream; font-family: "TF2 Build"; font-size: 22px; horizontal-alignment: center; }
                    Text { text: root.demo-drop-active ? "↓  RELEASE TO ADD THE SELECTED DEMO FILES  ↓" : "Drag one or more TF2 .dem files here, or choose them below."; color: root.demo-drop-active ? Tf2Colors.cream : Tf2Colors.muted; font-family: "Roboto Condensed"; font-size: 13px; horizontal-alignment: center; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        Tf2Button { width: 155px; text: "CHOOSE DEMOS"; clicked => { root.choose-demos(); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                drop-touch := TouchArea { clicked => { root.choose-demos(); } }
            }
            GridLayout {
                height: 118px; spacing: 8px;
                Row { Tf2Label { text: "EXPORT LOCATION"; width: 150px; } Tf2LineEdit { text <=> root.export-directory; } Tf2Button { width: 145px; text: "SELECT LOCATION"; clicked => { root.choose-export-directory(); } } }
                Row { Tf2Label { text: "ITEM SCHEMA (OPTIONAL)"; width: 150px; } Tf2LineEdit { text <=> root.item-schema; } Tf2Button { width: 145px; text: "SELECT SCHEMA"; clicked => { root.choose-item-schema(); } } }
                Row { Tf2Label { text: "PERFORMANCE"; width: 150px; } ComboBox { width: 170px; model: ["Low", "Medium", "High"]; current-value <=> root.performance-profile; } Tf2Body { text: "Low ~45%  •  Medium ~70%  •  High uses the full safe dynamic worker maximum"; color: Tf2Colors.muted; wrap: word-wrap; } }
            }
            HorizontalLayout {
                spacing: 9px;
                Tf2Panel {
                    width: 42%;
                    VerticalLayout {
                        padding: 10px; spacing: 5px;
                        Tf2Heading { text: root.imported-demo-count == 0 ? "IMPORTED DEMOS" : "IMPORTED DEMOS (" + root.imported-demo-count + ")"; }
                        if root.imported-demo-count == 0 : Tf2Body { text: "No demos selected yet."; color: Tf2Colors.muted; vertical-stretch: 1; vertical-alignment: center; horizontal-alignment: center; }
                        if root.imported-demo-count > 0 : ListView {
                            vertical-stretch: 1;
                            vertical-scrollbar-policy: always-on;
                            for demo in root.imported-demos : Tf2Body { height: 36px; text: demo; wrap: word-wrap; vertical-alignment: center; }
                        }
                    }
                }
                Tf2Panel { VerticalLayout { padding: 10px; spacing: 5px; Tf2Heading { text: "ANALYSIS LOG"; } AutoScrollLog { log-text: root.log-text; vertical-stretch: 1; } } }
            }
            Tf2Progress { value: root.progress-value; }
            HorizontalLayout {
                height: 40px; spacing: 7px;
                Tf2Button { width: 165px; text: "PARSE DEMOS"; enabled: !root.busy; tone: Tf2Colors.red; hover-tone: Tf2Colors.red-hover; pressed-tone: Tf2Colors.red-pressed; clicked => { root.start-batch(); } }
                Tf2Button { width: 105px; text: "CANCEL"; enabled: root.busy; clicked => { root.cancel-batch(); } }
                Tf2Button { width: 220px; text: "OPEN EXPORT LOCATION"; enabled: root.has-export; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; clicked => { root.open-export(); } }
                Tf2Button { width: 285px; text: "LOAD PREVIOUSLY PARSED EXPORT"; enabled: !root.busy; tone: Tf2Colors.blu; hover-tone: Tf2Colors.blu-hover; pressed-tone: Tf2Colors.blu-pressed; clicked => { root.load-export(); } }
                Rectangle { horizontal-stretch: 1; }
            }
            Tf2Body { height: 34px; text: root.resource-plan-text == "" ? root.status-text : root.resource-plan-text; color: #8ab3cd; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
        }

        if root.selected-page == 0 && root.compact : VerticalLayout {
            x: 0px; y: root.compact-nav-open ? 112px : 64px; width: root.width; height: root.height - self.y;
            padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 7px; spacing: 5px;
            Tf2Panel {
                height: 104px; background: root.demo-drop-active ? #263b49 : Tf2Colors.panel-dark; border-color: root.demo-drop-active ? Tf2Colors.blu-hover : Tf2Colors.border;
                VerticalLayout {
                    padding: 8px; spacing: 4px;
                    Text { height: 22px; text: root.demo-drop-active ? "READY TO DROP" : "DROP DEMOS HERE"; color: root.demo-drop-active ? Tf2Colors.blu-hover : Tf2Colors.cream; font-family: "TF2 Build"; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                    Text { height: 18px; text: root.demo-drop-active ? "RELEASE TO ADD TF2 DEMOS" : "Drag TF2 .dem files here or choose them below."; color: root.demo-drop-active ? Tf2Colors.cream : Tf2Colors.muted; font-family: "Roboto Condensed"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                    HorizontalLayout { Rectangle { horizontal-stretch: 1; } Tf2Button { width: 160px; height: 34px; label-font-size: 13px; text: "CHOOSE DEMOS"; clicked => { root.choose-demos(); } } Rectangle { horizontal-stretch: 1; } }
                }
            }
            GridLayout {
                height: 110px; spacing: 4px;
                Row { Tf2Label { text: "EXPORT"; width: 90px; } Tf2LineEdit { height: 32px; text <=> root.export-directory; } Tf2Button { width: 160px; height: 32px; label-font-size: 12px; text: "OUTPUT LOCATION"; clicked => { root.choose-export-directory(); } } }
                Row { Tf2Label { text: "SCHEMA"; width: 90px; } Tf2LineEdit { height: 32px; text <=> root.item-schema; placeholder: "Automatic item schema"; } Tf2Button { width: 140px; height: 32px; label-font-size: 12px; text: "SELECT SCHEMA"; clicked => { root.choose-item-schema(); } } }
                Row { Tf2Label { text: "PERFORMANCE"; width: 90px; } ComboBox { width: 145px; height: 32px; model: ["Low", "Medium", "High"]; current-value <=> root.performance-profile; } Tf2Body { text: "Low ~45%  •  Medium ~70%  •  High uses the full safe worker maximum"; color: Tf2Colors.muted; font-size: 11px; wrap: word-wrap; vertical-alignment: center; } }
            }
            HorizontalLayout {
                spacing: 5px;
                Tf2Panel {
                    width: 42%;
                    VerticalLayout {
                        padding: 7px; spacing: 3px;
                        Tf2Heading { text: root.imported-demo-count == 0 ? "IMPORTED DEMOS" : "IMPORTED DEMOS (" + root.imported-demo-count + ")"; font-size: 14px; }
                        if root.imported-demo-count == 0 : Tf2Body { text: "No demos selected yet."; color: Tf2Colors.muted; font-size: 12px; vertical-stretch: 1; vertical-alignment: center; horizontal-alignment: center; }
                        if root.imported-demo-count > 0 : ListView {
                            vertical-stretch: 1;
                            vertical-scrollbar-policy: always-on;
                            for demo in root.imported-demos : Tf2Body { height: 32px; text: demo; font-size: 12px; wrap: word-wrap; vertical-alignment: center; }
                        }
                    }
                }
                Tf2Panel { VerticalLayout { padding: 7px; spacing: 3px; Tf2Heading { text: "ANALYSIS LOG"; font-size: 14px; } AutoScrollLog { log-text: root.log-text; vertical-stretch: 1; } } }
            }
            Tf2Progress { value: root.progress-value; height: 9px; }
            HorizontalLayout {
                height: 34px; spacing: 5px;
                Tf2Button { text: "PARSE"; height: 32px; label-font-size: 13px; tone: Tf2Colors.red; hover-tone: Tf2Colors.red-hover; pressed-tone: Tf2Colors.red-pressed; enabled: !root.busy; clicked => { root.start-batch(); } }
                Tf2Button { text: "CANCEL"; height: 32px; label-font-size: 13px; enabled: root.busy; clicked => { root.cancel-batch(); } }
                Tf2Button { text: "OPEN LOCATION"; height: 32px; label-font-size: 13px; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; enabled: root.has-export; clicked => { root.open-export(); } }
                Tf2Button { text: "LOAD PREVIOUSLY PARSED EXPORT"; height: 32px; label-font-size: 11px; enabled: !root.busy; tone: Tf2Colors.blu; hover-tone: Tf2Colors.blu-hover; pressed-tone: Tf2Colors.blu-pressed; clicked => { root.load-export(); } }
            }
            Tf2Body { height: 30px; text: root.status-text; color: #8ab3cd; font-size: 11px; wrap: word-wrap; vertical-alignment: center; }
        }

        if root.selected-page == 1 && root.has-export : VerticalLayout {
            x: 0px; y: root.compact ? (root.compact-nav-open ? 112px : 64px) : 118px; width: root.width; height: root.height - self.y;
            padding: root.compact ? 9px : 14px; spacing: root.compact ? 5px : 8px;
            if !root.compact : HorizontalLayout {
                height: 38px; spacing: 7px;
                Tf2LineEdit { text <=> root.tag-filter; placeholder: "FILTER TAGS — FOR EXAMPLE: DEMOKNIGHT"; centered: true; edited(value) => { root.set-tag-filter(value); } focus-lost => { root.tag-filter = ""; root.set-tag-filter(""); } }
                MultiSelectDropdown { width: root.map-filter-width * 1px; content-width-px: root.map-filter-width; summary: root.map-filter-summary; search-placeholder: "Search maps..."; options: root.map-filter-options; search-text <=> root.map-filter-search; search-edited(value) => { root.search-map-filters(value); } toggled(value) => { root.toggle-map-filter(value); } }
                MultiSelectDropdown { width: root.server-type-filter-width * 1px; content-width-px: root.server-type-filter-width; summary: root.server-type-filter-summary; search-placeholder: "Search server types..."; options: root.server-type-filter-options; search-text <=> root.server-type-filter-search; search-edited(value) => { root.search-server-type-filters(value); } toggled(value) => { root.toggle-server-type-filter(value); } }
                Tf2Button { width: 120px; text: "REC: " + root.recorded-filter; clicked => { root.recorded-filter = root.recorded-filter == "Any" ? "Yes" : root.recorded-filter == "Yes" ? "No" : "Any"; root.set-recorded-filter(root.recorded-filter); } }
            }
            if !root.compact : Rectangle {
                height: 40px;
                HorizontalLayout {
                    x: 0px; y: 0px; width: 710px; height: parent.height; spacing: 5px;
                    Tf2Label { text: "CLASS"; width: 45px; }
                    ClassFilter { label: "ALL"; selected: !root.selected-scout && !root.selected-soldier && !root.selected-pyro && !root.selected-demoman && !root.selected-heavy && !root.selected-engineer && !root.selected-medic && !root.selected-sniper && !root.selected-spy; clicked => { root.toggle-class-filter("All"); } }
                    ClassFilter { icon: @image-url("assets/classes/scout.png"); selected: root.selected-scout; clicked => { root.toggle-class-filter("Scout"); } }
                    ClassFilter { icon: @image-url("assets/classes/soldier.png"); selected: root.selected-soldier; clicked => { root.toggle-class-filter("Soldier"); } }
                    ClassFilter { icon: @image-url("assets/classes/pyro.png"); selected: root.selected-pyro; clicked => { root.toggle-class-filter("Pyro"); } }
                    ClassFilter { icon: @image-url("assets/classes/demoman.png"); selected: root.selected-demoman; clicked => { root.toggle-class-filter("Demoman"); } }
                    ClassFilter { icon: @image-url("assets/classes/heavy.png"); selected: root.selected-heavy; clicked => { root.toggle-class-filter("Heavy"); } }
                    ClassFilter { icon: @image-url("assets/classes/engineer.png"); selected: root.selected-engineer; clicked => { root.toggle-class-filter("Engineer"); } }
                    ClassFilter { icon: @image-url("assets/classes/medic.png"); selected: root.selected-medic; clicked => { root.toggle-class-filter("Medic"); } }
                    ClassFilter { icon: @image-url("assets/classes/sniper.png"); selected: root.selected-sniper; clicked => { root.toggle-class-filter("Sniper"); } }
                    ClassFilter { icon: @image-url("assets/classes/spy.png"); selected: root.selected-spy; clicked => { root.toggle-class-filter("Spy"); } }
                    Rectangle { width: 20px; }
                    MinimumScoreControl { width: 205px; label: "MINIMUM SCORE"; value <=> root.minimum-score; edited(value) => { root.refresh-filter("", value); } }
                }
                HorizontalLayout {
                    x: parent.width - root.map-filter-width * 1px - root.server-type-filter-width * 1px - 134px;
                    y: 0px; width: root.map-filter-width * 1px; height: parent.height; spacing: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        width: 168px; spacing: 3px;
                        Tf2Label { text: "BEFORE FIRST TICK"; width: 95px; font-size: 12px; horizontal-alignment: center; }
                        SecondsPicker { width: 70px; seconds <=> root.lead-seconds; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    x: parent.width - root.server-type-filter-width * 1px - 127px;
                    y: 0px; width: root.server-type-filter-width * 1px; height: parent.height; spacing: 0px;
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        width: 168px; spacing: 3px;
                        Tf2Label { text: "AFTER LAST TICK"; width: 95px; font-size: 12px; horizontal-alignment: center; }
                        SecondsPicker { width: 70px; seconds <=> root.outro-seconds; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
            }
            if root.compact : HorizontalLayout {
                height: 34px; spacing: 5px;
                Tf2LineEdit { text <=> root.tag-filter; placeholder: "FILTER TAGS"; centered: true; edited(value) => { root.set-tag-filter(value); } focus-lost => { root.tag-filter = ""; root.set-tag-filter(""); } }
                Tf2Button { width: 98px; height: 32px; text: root.candidate-filters-open ? "CLOSE" : "FILTERS"; clicked => { root.candidate-filters-open = !root.candidate-filters-open; } }
                Tf2Button { width: 165px; height: 32px; text: "OPEN HLAE"; enabled: root.selected-count == 1 && root.recording-ready; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; clicked => { root.launch-manual-hlae(); } }
                Tf2Button { width: 120px; height: 32px; text: "PREVIEW"; enabled: root.selected-count == 1; tone: Tf2Colors.blu; hover-tone: Tf2Colors.blu-hover; pressed-tone: Tf2Colors.blu-pressed; clicked => { root.preview-selected(); } }
                Tf2Button { width: 120px; height: 32px; text: "RECORD"; enabled: root.selected-count > 0 && root.recording-ready; tone: Tf2Colors.red; hover-tone: Tf2Colors.red-hover; pressed-tone: Tf2Colors.red-pressed; clicked => { root.record-selected(); } }
            }
            if root.compact && root.candidate-filters-open : Tf2Panel {
                height: 112px;
                GridLayout {
                    padding: 7px; spacing: 5px;
                    Row {
                        MultiSelectDropdown { content-width-px: root.map-filter-width; summary: root.map-filter-summary; search-placeholder: "Search maps..."; options: root.map-filter-options; search-text <=> root.map-filter-search; search-edited(value) => { root.search-map-filters(value); } toggled(value) => { root.toggle-map-filter(value); } }
                        ClassMultiSelectDropdown { summary: root.class-filter-summary; scout: root.selected-scout; soldier: root.selected-soldier; pyro: root.selected-pyro; demoman: root.selected-demoman; heavy: root.selected-heavy; engineer: root.selected-engineer; medic: root.selected-medic; sniper: root.selected-sniper; spy: root.selected-spy; toggled(value) => { root.toggle-class-filter(value); } }
                        MultiSelectDropdown { content-width-px: root.server-type-filter-width; summary: root.server-type-filter-summary; search-placeholder: "Search server types..."; options: root.server-type-filter-options; search-text <=> root.server-type-filter-search; search-edited(value) => { root.search-server-type-filters(value); } toggled(value) => { root.toggle-server-type-filter(value); } }
                    }
                    Row { Tf2Button { height: 31px; text: "REC: " + root.recorded-filter; clicked => { root.recorded-filter = root.recorded-filter == "Any" ? "Yes" : root.recorded-filter == "Yes" ? "No" : "Any"; root.set-recorded-filter(root.recorded-filter); } } MinimumScoreControl { height: 31px; label: "MIN. SCORE"; value <=> root.minimum-score; edited(value) => { root.refresh-filter("", value); } } Tf2Button { height: 31px; text: root.all-visible-selected ? "DESELECT ALL" : "SELECT ALL"; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; clicked => { root.select-all-visible(); } } }
                }
            }
            if !root.compact : HorizontalLayout {
                height: 40px; spacing: 7px;
                Tf2Button { width: 170px; text: root.all-visible-selected ? "DESELECT ALL" : "SELECT ALL"; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; clicked => { root.select-all-visible(); } }
                Tf2Button { width: 190px; text: "PREVIEW IN TF2"; enabled: root.selected-count == 1; tone: Tf2Colors.blu; hover-tone: Tf2Colors.blu-hover; pressed-tone: Tf2Colors.blu-pressed; clicked => { root.preview-selected(); } }
                Tf2Button { width: 250px; text: "LAUNCH MANUAL MIRV SESSION"; enabled: root.selected-count == 1 && root.recording-ready; tone: Tf2Colors.gold; hover-tone: Tf2Colors.gold-hover; pressed-tone: Tf2Colors.gold-pressed; clicked => { root.launch-manual-hlae(); } }
                Tf2Button { width: 205px; text: "RECORD WITH HLAE"; enabled: root.selected-count > 0 && root.recording-ready; tone: Tf2Colors.red; hover-tone: Tf2Colors.red-hover; pressed-tone: Tf2Colors.red-pressed; clicked => { root.record-selected(); } }
                Tf2Button { width: 145px; text: "VIEW DETAILS"; enabled: root.selected-count == 1; clicked => { root.view-selected-details(); } }
                Rectangle { horizontal-stretch: 1; } Tf2Body { text: root.selected-count + " SELECTED"; color: Tf2Colors.muted; }
            }
            CandidateTable { rows: root.candidate-rows; compact: root.compact; tags-width-px: root.candidate-tags-width; horizontal-offset <=> root.candidate-horizontal-offset; drag(index, delta, selecting, additive) => { root.drag-select-candidates(index, delta, selecting, additive); } selection-done => { root.selection-changed(); } }
            HorizontalLayout {
                height: 21px;
                Tf2Body { text: root.candidate-summary; color: Tf2Colors.muted; font-size: root.compact ? 11px : 13px; wrap: word-wrap; }
            }
        }

        if root.selected-page == 2 && root.has-export && !root.minimal-recording-settings : recording-settings-scroll := ScrollView {
            x: 0px; y: root.compact ? (root.compact-nav-open ? 112px : 64px) : 118px; width: root.width; height: root.height - self.y;
            vertical-scrollbar-policy: as-needed;
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.width;
            viewport-height: settings-content.height + (root.compact ? 18px : 28px);
            settings-content := VerticalLayout {
            x: root.compact ? 9px : 14px;
            y: root.compact ? 9px : 14px;
            width: recording-settings-scroll.width - (root.compact ? 30px : 42px);
            height: Math.max(
                recording-settings-scroll.height - (root.compact ? 18px : 28px),
                root.compact ? (862px + root.recording-advanced-panel-height) : (920px + root.recording-advanced-panel-height)
            );
            spacing: root.compact ? 7px : 10px;
            if !root.compact : HorizontalLayout { height: 26px; Tf2Heading { font-size: 21px; text: "HLAE RECORDING SETTINGS"; } Rectangle { horizontal-stretch: 1; } }
            HorizontalLayout {
                height: root.compact ? 266px : 306px;
                spacing: root.compact ? 7px : 11px;
                Tf2Panel {
                    width: 50%;
                    VerticalLayout {
                        padding: root.compact ? 9px : 12px; spacing: root.compact ? 6px : 8px;
                        Tf2Heading { height: root.compact ? 20px : 26px; font-size: root.compact ? 16px : 20px; text: "PATHS & OUTPUT"; }
                        GridLayout {
                            spacing: root.compact ? 5px : 7px;
                            Row { Tf2Label { width: root.compact ? 80px : 125px; font-size: root.compact ? 14px : 15px; text: root.compact ? "TF2 EXE" : "TF2 EXECUTABLE"; } Tf2LineEdit { height: root.compact ? 32px : 36px; text <=> root.tf2-path; } Tf2Button { width: root.compact ? 80px : 100px; height: root.compact ? 32px : 36px; label-font-size: root.compact ? 14px : 16px; text: "BROWSE"; clicked => { root.choose-setting-path("tf2"); } } }
                            Row { Tf2Label { width: root.compact ? 80px : 125px; font-size: root.compact ? 14px : 15px; text: "HLAE"; } Tf2LineEdit { height: root.compact ? 32px : 36px; text <=> root.hlae-path; } Tf2Button { width: root.compact ? 80px : 100px; height: root.compact ? 32px : 36px; label-font-size: root.compact ? 14px : 16px; text: "BROWSE"; clicked => { root.choose-setting-path("hlae"); } } }
                            Row { Tf2Label { width: root.compact ? 80px : 125px; font-size: root.compact ? 14px : 15px; text: "FFMPEG"; } Tf2LineEdit { height: root.compact ? 32px : 36px; text <=> root.ffmpeg-path; } Tf2Button { width: root.compact ? 80px : 100px; height: root.compact ? 32px : 36px; label-font-size: root.compact ? 14px : 16px; text: "BROWSE"; clicked => { root.choose-setting-path("ffmpeg"); } } }
                            Row { Tf2Label { width: root.compact ? 80px : 125px; font-size: root.compact ? 14px : 15px; text: "OUTPUT"; } Tf2LineEdit { height: root.compact ? 32px : 36px; text <=> root.recording-directory; } Tf2Button { width: root.compact ? 80px : 100px; height: root.compact ? 32px : 36px; label-font-size: root.compact ? 14px : 16px; text: "BROWSE"; clicked => { root.choose-setting-path("recording-output"); } } }
                            Row { Tf2Label { width: root.compact ? 80px : 125px; font-size: root.compact ? 14px : 15px; text: root.compact ? "LAUNCH" : "MANUAL OPTIONS"; } Tf2LineEdit { height: root.compact ? 32px : 36px; text <=> root.manual-hlae-launch-options; placeholder-text: "Optional safe TF2 switches, e.g. -high -nojoy"; } }
                            if root.compact : Row { Tf2Label { width: 80px; font-size: 14px; text: "FPS"; } ComboBox { width: 90px; height: 32px; model: ["120", "60", "240", "480"]; current-value <=> root.capture-fps; } }
                            if !root.compact : Row { Tf2Label { width: 125px; font-size: 15px; text: "FORMAT"; } ComboBox { height: 36px; model: ["MP4 - Standard", "MP4 - Compatible", "MP4 - Lossless", "MOV - DNxHR", "TGA Image Sequence", "JPG Image Sequence", "AVI - Raw"]; current-value <=> root.recording-format; } Rectangle { width: 18px; } Tf2Label { width: 32px; font-size: 15px; text: "FPS"; horizontal-alignment: right; } ComboBox { width: 90px; height: 36px; model: ["120", "60", "240", "480"]; current-value <=> root.capture-fps; } if root.recording-format == "JPG Image Sequence" : Tf2Label { width: 72px; font-size: 15px; text: "JPG"; } if root.recording-format == "JPG Image Sequence" : SpinBox { width: 82px; height: 36px; value <=> root.jpg-quality; minimum: 1; maximum: 100; } }
                        }
                    }
                }
                Tf2Panel {
                    VerticalLayout {
                        padding: root.compact ? 9px : 12px; spacing: root.compact ? 6px : 8px;
                        Tf2Heading { height: root.compact ? 20px : 26px; font-size: root.compact ? 16px : 20px; text: "VIDEO & HUD"; }
                        GridLayout {
                            spacing: root.compact ? 5px : 7px;
                            Row { Tf2Label { width: root.compact ? 72px : 105px; font-size: root.compact ? 14px : 15px; text: root.compact ? "RES" : "RESOLUTION"; } ComboBox { height: root.compact ? 32px : 36px; model: ["1280x720", "1920x1080", "2560x1440", "3840x2160"]; current-value <=> root.resolution; } Tf2Label { width: root.compact ? 28px : 55px; font-size: root.compact ? 14px : 15px; text: "DX"; } ComboBox { width: root.compact ? 100px : 130px; height: root.compact ? 32px : 36px; model: ["Default", "98", "95", "90", "81", "80"]; current-value <=> root.dx-level; } }
                            Row { Tf2Label { width: root.compact ? 72px : 105px; font-size: root.compact ? 14px : 15px; text: root.compact ? "MODEL" : "VIEWMODELS"; } ComboBox { height: root.compact ? 32px : 36px; model: ["On", "Off"]; current-value <=> root.viewmodels; } Tf2Label { width: root.compact ? 32px : 55px; font-size: root.compact ? 14px : 15px; text: "FOV"; } SpinBox { width: root.compact ? 90px : 100px; height: root.compact ? 32px : 36px; value <=> root.viewmodel-fov; minimum: 1; maximum: 179; } }
                            Row { Tf2Label { width: root.compact ? 72px : 105px; font-size: root.compact ? 14px : 15px; text: "SKYBOX"; } ComboBox { height: root.compact ? 32px : 36px; model: ["Default", "realsky1", "realsky3", "sky27", "sky41", "sky56", "sky_sky1_01", "sky_sky2_01", "sky_sky3_01", "sky_sky4_01", "sky_sky5_01", "sky_sky6_01"]; current-value <=> root.skybox; } }
                            Row { Tf2Label { width: root.compact ? 72px : 105px; font-size: root.compact ? 14px : 15px; text: "HUD"; } ComboBox { height: root.compact ? 32px : 36px; model: ["Kill notices only", "Keep current", "Default TF2 HUD", "Medic recording HUD"]; current-value <=> root.hud; } }
                            if root.compact : Row { Tf2Label { width: 72px; font-size: 14px; text: "FORMAT"; } ComboBox { height: 32px; model: ["MP4 - Standard", "MP4 - Compatible", "MP4 - Lossless", "MOV - DNxHR", "TGA Image Sequence", "JPG Image Sequence", "AVI - Raw"]; current-value <=> root.recording-format; } if root.recording-format == "JPG Image Sequence" : SpinBox { width: 70px; height: 32px; value <=> root.jpg-quality; minimum: 1; maximum: 100; } }
                        }
                    }
                }
            }
            Tf2Panel {
                height: root.recording-advanced-panel-height;
                VerticalLayout {
                    padding: root.compact ? 5px : 8px; spacing: root.compact ? 3px : 5px;
                    HorizontalLayout {
                        height: root.compact ? 30px : 28px; spacing: 8px;
                        Tf2Button { width: root.compact ? 225px : 285px; height: root.compact ? 30px : 28px; label-font-size: root.compact ? 12px : 14px; text: root.advanced-encoding-open ? "-  ADVANCED ENCODING OPTIONS" : "+  ADVANCED ENCODING OPTIONS"; clicked => { root.advanced-encoding-open = !root.advanced-encoding-open; } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    if root.advanced-encoding-open && (root.recording-format == "MP4 - Standard" || root.recording-format == "MP4 - Compatible") : VerticalLayout {
                        spacing: root.compact ? 3px : 5px;
                        HorizontalLayout {
                            height: root.compact ? 28px : 32px; spacing: 5px;
                            Tf2Label { width: root.compact ? 96px : 145px; text: root.compact ? "COMPATIBILITY" : "MP4 COMPATIBILITY"; }
                            ComboBox { height: root.compact ? 28px : 32px; model: ["DaVinci Resolve / Universal", "Maximum Color Quality", "Custom"]; current-value <=> root.mp4-compatibility; }
                        }
                        if root.mp4-compatibility != "Custom" : HorizontalLayout { height: root.compact ? 28px : 32px; spacing: 5px; Tf2Label { width: root.compact ? 96px : 145px; text: "AUDIO"; } ComboBox { width: root.compact ? 75px : 100px; height: root.compact ? 28px : 32px; model: ["AAC"]; current-value <=> root.mp4-audio-codec; } ComboBox { width: root.compact ? 75px : 105px; height: root.compact ? 28px : 32px; model: ["192", "256", "320"]; current-value <=> root.mp4-audio-bitrate; } Tf2Body { text: "kbps"; color: Tf2Colors.muted; vertical-alignment: center; } }
                        if root.mp4-compatibility == "Custom" && !root.compact : VerticalLayout {
                            spacing: 5px;
                            HorizontalLayout { height: 32px; spacing: 5px; Tf2Label { width: 110px; text: "VIDEO CODEC"; } ComboBox { model: ["H.264 / libx264"]; current-value <=> root.mp4-video-codec; } Tf2Label { width: 105px; text: "PIXEL FORMAT"; } ComboBox { width: 130px; model: ["yuv420p", "yuv422p", "yuv444p"]; current-value <=> root.mp4-pixel-format; } Tf2Label { width: 105px; text: "PROFILE"; } if root.mp4-pixel-format == "yuv420p" : ComboBox { width: 205px; model: ["High"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv422p" : ComboBox { width: 205px; model: ["High 4:2:2"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv444p" : ComboBox { width: 205px; model: ["High 4:4:4 Predictive"]; current-value <=> root.mp4-h264-profile; } }
                            HorizontalLayout { height: 32px; spacing: 5px; Tf2Label { width: 110px; text: "CRF QUALITY"; } SpinBox { width: 90px; value <=> root.mp4-crf; minimum: 0; maximum: 35; } Tf2Label { width: 85px; text: "PRESET"; } ComboBox { width: 130px; model: ["veryfast", "faster", "fast", "medium", "slow", "slower"]; current-value <=> root.mp4-encoder-preset; } Tf2Label { width: 70px; text: "AUDIO"; } ComboBox { width: 85px; model: ["AAC"]; current-value <=> root.mp4-audio-codec; } ComboBox { width: 105px; model: ["192", "256", "320"]; current-value <=> root.mp4-audio-bitrate; } Tf2Body { width: 35px; text: "kbps"; color: Tf2Colors.muted; vertical-alignment: center; } }
                        }
                        if root.mp4-compatibility == "Custom" && root.compact : GridLayout {
                            spacing: 3px;
                            Row { Tf2Label { width: 90px; text: "CODEC"; } ComboBox { height: 27px; model: ["H.264 / libx264"]; current-value <=> root.mp4-video-codec; } Tf2Label { width: 72px; text: "PIXEL"; } ComboBox { width: 115px; height: 27px; model: ["yuv420p", "yuv422p", "yuv444p"]; current-value <=> root.mp4-pixel-format; } }
                            Row { Tf2Label { width: 90px; text: "PROFILE"; } if root.mp4-pixel-format == "yuv420p" : ComboBox { height: 27px; model: ["High"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv422p" : ComboBox { height: 27px; model: ["High 4:2:2"]; current-value <=> root.mp4-h264-profile; } if root.mp4-pixel-format == "yuv444p" : ComboBox { height: 27px; model: ["High 4:4:4 Predictive"]; current-value <=> root.mp4-h264-profile; } Tf2Label { width: 72px; text: "CRF"; } SpinBox { width: 115px; height: 27px; value <=> root.mp4-crf; minimum: 0; maximum: 35; } }
                            Row { Tf2Label { width: 90px; text: "PRESET"; } ComboBox { height: 27px; model: ["veryfast", "faster", "fast", "medium", "slow", "slower"]; current-value <=> root.mp4-encoder-preset; } Tf2Label { width: 72px; text: "AUDIO"; } ComboBox { width: 55px; height: 27px; model: ["AAC"]; current-value <=> root.mp4-audio-codec; } ComboBox { width: 60px; height: 27px; model: ["192", "256", "320"]; current-value <=> root.mp4-audio-bitrate; } Tf2Body { width: 35px; text: "kbps"; color: Tf2Colors.muted; vertical-alignment: center; } }
                        }
                    }
                    if root.advanced-encoding-open && root.recording-format == "AVI - Raw" : VerticalLayout {
                        spacing: root.compact ? 3px : 5px;
                        HorizontalLayout {
                            height: root.compact ? 28px : 32px; spacing: 5px;
                            Tf2Label { width: root.compact ? 96px : 145px; text: "AVI CODEC"; }
                            ComboBox { height: root.compact ? 28px : 32px; model: ["Original HLAE Raw", "FFV1 Lossless", "HuffYUV Lossless"]; current-value <=> root.avi-video-codec; }
                        }
                        HorizontalLayout {
                            height: root.compact ? 28px : 32px; spacing: 5px;
                            Tf2Label { width: root.compact ? 96px : 145px; text: "PIXEL FORMAT"; }
                            if root.avi-video-codec == "Original HLAE Raw" : ComboBox { height: root.compact ? 28px : 32px; model: ["HLAE Native"]; current-value <=> root.avi-pixel-format; }
                            if root.avi-video-codec == "FFV1 Lossless" : ComboBox { height: root.compact ? 28px : 32px; model: ["bgr0", "yuv422p", "yuv444p"]; current-value <=> root.avi-pixel-format; }
                            if root.avi-video-codec == "HuffYUV Lossless" : ComboBox { height: root.compact ? 28px : 32px; model: ["rgb24", "yuv422p"]; current-value <=> root.avi-pixel-format; }
                        }
                    }
                    if root.advanced-encoding-open && root.recording-format == "MOV - DNxHR" : VerticalLayout {
                        spacing: root.compact ? 3px : 5px;
                        HorizontalLayout {
                            height: root.compact ? 28px : 32px; spacing: 5px;
                            Tf2Label { width: root.compact ? 96px : 145px; text: "DNxHR PROFILE"; }
                            ComboBox { height: root.compact ? 28px : 32px; model: ["LB", "SQ", "HQ", "HQX", "444"]; current-value <=> root.dnxhr-profile; }
                        }
                    }
                }
            }
            Tf2Panel {
                height: root.compact ? 130px : 160px;
                VerticalLayout {
                    padding: root.compact ? 9px : 12px; spacing: root.compact ? 5px : 8px;
                    Tf2Heading { height: root.compact ? 20px : 26px; font-size: root.compact ? 16px : 20px; text: "RECORDING PROFILE"; }
                    HorizontalLayout {
                        spacing: root.compact ? 8px : 22px;
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Maximum-quality graphics"; checked <=> root.maximum-graphics; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Enable motion blur"; checked <=> root.motion-blur; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable hit sounds"; checked <=> root.disable-hit-sounds; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable voice chat"; checked <=> root.disable-voice-chat; } }
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Minimal HUD"; checked <=> root.minimal-hud; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable combat text"; checked <=> root.disable-combat-text; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable crosshair"; checked <=> root.disable-crosshair; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable crosshair switching"; checked <=> root.disable-crosshair-switching; } }
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "3D player model in HUD"; checked <=> root.hud-player-model; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Isolate custom resources"; checked <=> root.isolate-custom-resources; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable announcer"; checked <=> root.disable-announcer; } Tf2CheckBox { height: root.compact ? 22px : 28px; label-font-size: root.compact ? 13px : 14px; text: "Disable applause"; checked <=> root.disable-applause; } }
                        if root.compact : VerticalLayout { spacing: 0px; Tf2CheckBox { height: 22px; label-font-size: 13px; text: "Disable domination/revenge"; checked <=> root.disable-domination; } }
                        if !root.compact : VerticalLayout { spacing: 0px; Tf2CheckBox { height: 28px; label-font-size: 14px; text: "Disable domination/revenge"; checked <=> root.disable-domination; } }
                    }
                }
            }
            MirvShortcutPanel {
                compact: root.compact;
                advance-time <=> root.mirv-advance-time; toggle-hud <=> root.mirv-toggle-hud;
                show-help <=> root.mirv-show-help; back-one-second <=> root.mirv-back-one-second;
                safe-restart <=> root.mirv-safe-restart; next-kill-tick <=> root.mirv-next-kill-tick;
                pause-resume <=> root.mirv-pause-resume; enter-camera <=> root.mirv-enter-camera;
                add-keyframe <=> root.mirv-add-keyframe; play-campath <=> root.mirv-play-campath;
                draw-campath <=> root.mirv-draw-campath;
                start-recording <=> root.mirv-start-recording; stop-recording <=> root.mirv-stop-recording;
                print-keyframes <=> root.mirv-print-keyframes; save-campath <=> root.mirv-save-campath;
                execute-director-action <=> root.mirv-execute-director-action;
                overlay-panel-toggle <=> root.mirv-overlay-panel-toggle;
            }
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 0px;
                Tf2Panel {
                    height: root.compact ? 54px : 70px;
                    HorizontalLayout {
                        padding: root.compact ? 7px : 11px; spacing: root.compact ? 7px : 9px;
                        Tf2Label { width: root.compact ? 110px : 165px; font-size: root.compact ? 14px : 16px; text: root.compact ? "RESOURCES" : "CUSTOM RESOURCES"; }
                        Tf2LineEdit { text <=> root.custom-resources; }
                        Tf2Button { width: root.compact ? 82px : 115px; height: root.compact ? 34px : 42px; label-font-size: root.compact ? 13px : 16px; text: "ADD VPK"; clicked => { root.choose-custom-resources("files"); } }
                        Tf2Button { width: root.compact ? 82px : 115px; height: root.compact ? 34px : 42px; label-font-size: root.compact ? 13px : 16px; text: "FOLDER"; clicked => { root.choose-custom-resources("folder"); } }
                        Tf2Button { width: root.compact ? 72px : 100px; height: root.compact ? 34px : 42px; label-font-size: root.compact ? 13px : 16px; text: "CLEAR"; clicked => { root.custom-resources = ""; } }
                    }
                }
                Rectangle { height: root.compact ? 8px : 16px; vertical-stretch: 1; }
            }
            }
        }

        if root.selected-page == 2 && root.has-export && root.minimal-recording-settings : minimal-recording-settings-scroll := ScrollView {
            x: 0px; y: root.compact-nav-open ? 112px : 64px; width: root.width; height: root.height - self.y;
            vertical-scrollbar-policy: as-needed;
            horizontal-scrollbar-policy: always-off;
            viewport-width: self.width;
            viewport-height: minimal-settings-content.height + 18px;
            minimal-settings-content := VerticalLayout {
                x: 9px; y: 9px;
                width: minimal-recording-settings-scroll.width - 30px;
                height: Math.max(minimal-recording-settings-scroll.height - 18px, self.preferred-height);
                spacing: 5px;

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 0 ? "-  " : "+  ") + "PATHS & OUTPUT";
                    tone: root.recording-settings-section == 0 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 0 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 0 ? Tf2Colors.gold-pressed : Tf2Colors.border;
                    clicked => { root.recording-settings-section = root.recording-settings-section == 0 ? -1 : 0; }
                }
                if root.recording-settings-section == 0 : Tf2Panel {
                    height: 224px;
                    GridLayout {
                        padding: 7px; spacing: 4px;
                        Row { Tf2Label { width: 92px; text: "TF2 EXE"; } Tf2LineEdit { height: 30px; text <=> root.tf2-path; } Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "BROWSE"; clicked => { root.choose-setting-path("tf2"); } } }
                        Row { Tf2Label { width: 92px; text: "HLAE"; } Tf2LineEdit { height: 30px; text <=> root.hlae-path; } Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "BROWSE"; clicked => { root.choose-setting-path("hlae"); } } }
                        Row { Tf2Label { width: 92px; text: "FFMPEG"; } Tf2LineEdit { height: 30px; text <=> root.ffmpeg-path; } Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "BROWSE"; clicked => { root.choose-setting-path("ffmpeg"); } } }
                        Row { Tf2Label { width: 92px; text: "OUTPUT"; } Tf2LineEdit { height: 30px; text <=> root.recording-directory; } Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "BROWSE"; clicked => { root.choose-setting-path("recording-output"); } } }
                        Row { Tf2Label { width: 92px; text: "MANUAL OPTS"; } Tf2LineEdit { height: 30px; text <=> root.manual-hlae-launch-options; placeholder-text: "Optional safe TF2 switches"; } }
                        Row { Tf2Label { width: 92px; text: "FORMAT"; } ComboBox { height: 30px; model: ["MP4 - Standard", "MP4 - Compatible", "MP4 - Lossless", "MOV - DNxHR", "TGA Image Sequence", "JPG Image Sequence", "AVI - Raw"]; current-value <=> root.recording-format; } Tf2Label { width: 32px; text: "FPS"; horizontal-alignment: right; } ComboBox { width: 82px; height: 30px; model: ["120", "60", "240", "480"]; current-value <=> root.capture-fps; } if root.recording-format == "JPG Image Sequence" : SpinBox { width: 70px; height: 30px; value <=> root.jpg-quality; minimum: 1; maximum: 100; } }
                    }
                }

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 1 ? "-  " : "+  ") + "VIDEO & HUD";
                    tone: root.recording-settings-section == 1 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 1 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 1 ? Tf2Colors.gold-pressed : Tf2Colors.border;
                    clicked => { root.recording-settings-section = root.recording-settings-section == 1 ? -1 : 1; }
                }
                if root.recording-settings-section == 1 : Tf2Panel {
                    height: 158px;
                    GridLayout {
                        padding: 7px; spacing: 4px;
                        Row { Tf2Label { width: 92px; text: "RESOLUTION"; } ComboBox { height: 30px; model: ["1280x720", "1920x1080", "2560x1440", "3840x2160"]; current-value <=> root.resolution; } Tf2Label { width: 28px; text: "DX"; } ComboBox { width: 110px; height: 30px; model: ["Default", "98", "95", "90", "81", "80"]; current-value <=> root.dx-level; } }
                        Row { Tf2Label { width: 92px; text: "VIEWMODELS"; } ComboBox { height: 30px; model: ["On", "Off"]; current-value <=> root.viewmodels; } Tf2Label { width: 32px; text: "FOV"; } SpinBox { width: 90px; height: 30px; value <=> root.viewmodel-fov; minimum: 1; maximum: 179; } }
                        Row { Tf2Label { width: 92px; text: "SKYBOX"; } ComboBox { height: 30px; model: ["Default", "realsky1", "realsky3", "sky27", "sky41", "sky56", "sky_sky1_01", "sky_sky2_01", "sky_sky3_01", "sky_sky4_01", "sky_sky5_01", "sky_sky6_01"]; current-value <=> root.skybox; } }
                        Row { Tf2Label { width: 92px; text: "HUD"; } ComboBox { height: 30px; model: ["Kill notices only", "Keep current", "Default TF2 HUD", "Medic recording HUD"]; current-value <=> root.hud; } }
                    }
                }

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 2 ? "-  " : "+  ") + "ADVANCED ENCODING OPTIONS";
                    tone: root.recording-settings-section == 2 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 2 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 2 ? Tf2Colors.gold-pressed : Tf2Colors.border;

    in-out property <string> mirv-start-recording: "9";
    in-out property <string> mirv-stop-recording: "0";
    in-out property <string> mirv-print-keyframes: "-";
    in-out property <string> mirv-save-campath: "=";
    in-out property <string> mirv-execute-director-action: "'";
    in-out property <string> mirv-overlay-panel-toggle: "C";
    in-out property <string> custom-resources;

    callback choose-demos(); callback choose-export-directory(); callback choose-item-schema();
    callback start-batch(); callback cancel-batch(); callback load-export(); callback open-export();
    callback refresh-filter(string, int); callback drag-select-candidates(int, float, bool, bool); callback selection-changed(); callback select-all-visible();
    callback set-tag-filter(string); callback toggle-class-filter(string); callback toggle-map-filter(string); callback search-map-filters(string);
    callback toggle-server-type-filter(string); callback search-server-type-filters(string); callback set-recorded-filter(string);
    callback preview-selected(); callback launch-manual-hlae(); callback record-selected(); callback choose-setting-path(string); callback recording-settings-changed();
    callback view-selected-details(); callback view-recording-logs(); callback update-recording-estimate(); callback choose-custom-resources(string);

    changed tf2-path => { if !root.recording-settings-syncing { root.recording-settings-changed(); } }
    changed hlae-path => { if !root.recording-settings-syncing { root.recording-settings-changed(); } }
    changed ffmpeg-path => { if !root.recording-settings-syncing { root.recording-settings-changed(); } }

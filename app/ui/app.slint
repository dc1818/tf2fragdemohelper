    in-out property <bool> disable-announcer: true;
    in-out property <bool> disable-applause: true;
    in-out property <bool> disable-domination: true;
    in-out property <string> mirv-advance-time: "[";
    in-out property <string> mirv-toggle-hud: "]";
    in-out property <string> mirv-show-help: "1";
    in-out property <string> mirv-back-one-second: "2";
    in-out property <string> mirv-safe-restart: "3";
    in-out property <string> mirv-next-kill-tick: "4";
    in-out property <string> mirv-pause-resume: "5";
    in-out property <string> mirv-enter-camera: "6";
    in-out property <string> mirv-add-keyframe: "7";
    in-out property <string> mirv-play-campath: "8";

                if root.recording-settings-section == 2 && root.recording-format == "MOV - DNxHR" : Tf2Panel {
                    height: 38px;
                    HorizontalLayout { padding: 5px; spacing: 5px; Tf2Label { width: 105px; text: "DNxHR PROFILE"; } ComboBox { height: 28px; model: ["LB", "SQ", "HQ", "HQX", "444"]; current-value <=> root.dnxhr-profile; } }
                }

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 3 ? "-  " : "+  ") + "RECORDING PROFILE";
                    tone: root.recording-settings-section == 3 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 3 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 3 ? Tf2Colors.gold-pressed : Tf2Colors.border;
                    clicked => { root.recording-settings-section = root.recording-settings-section == 3 ? -1 : 3; }
                }
                if root.recording-settings-section == 3 : Tf2Panel {
                    height: 102px;
                    HorizontalLayout {
                        padding: 6px; spacing: 8px;
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: 22px; text: "Maximum-quality graphics"; checked <=> root.maximum-graphics; } Tf2CheckBox { height: 22px; text: "Enable motion blur"; checked <=> root.motion-blur; } Tf2CheckBox { height: 22px; text: "Disable hit sounds"; checked <=> root.disable-hit-sounds; } Tf2CheckBox { height: 22px; text: "Disable voice chat"; checked <=> root.disable-voice-chat; } }
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: 22px; text: "Minimal HUD"; checked <=> root.minimal-hud; } Tf2CheckBox { height: 22px; text: "Disable combat text"; checked <=> root.disable-combat-text; } Tf2CheckBox { height: 22px; text: "Disable crosshair"; checked <=> root.disable-crosshair; } Tf2CheckBox { height: 22px; text: "Disable crosshair switching"; checked <=> root.disable-crosshair-switching; } }
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: 22px; text: "3D player model in HUD"; checked <=> root.hud-player-model; } Tf2CheckBox { height: 22px; text: "Isolate custom resources"; checked <=> root.isolate-custom-resources; } Tf2CheckBox { height: 22px; text: "Disable announcer"; checked <=> root.disable-announcer; } Tf2CheckBox { height: 22px; text: "Disable applause"; checked <=> root.disable-applause; } }
                        VerticalLayout { spacing: 0px; Tf2CheckBox { height: 22px; text: "Disable domination/revenge"; checked <=> root.disable-domination; } }
                    }
                }

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 4 ? "-  " : "+  ") + "MIRV RECORDING SHORTCUTS";
                    tone: root.recording-settings-section == 4 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 4 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 4 ? Tf2Colors.gold-pressed : Tf2Colors.border;
                    clicked => { root.recording-settings-section = root.recording-settings-section == 4 ? -1 : 4; }
                }
                if root.recording-settings-section == 4 : MirvShortcutPanel {
                    compact: true;
                    advance-time <=> root.mirv-advance-time; toggle-hud <=> root.mirv-toggle-hud;
                    show-help <=> root.mirv-show-help; back-one-second <=> root.mirv-back-one-second;
                    safe-restart <=> root.mirv-safe-restart; next-kill-tick <=> root.mirv-next-kill-tick;
                    pause-resume <=> root.mirv-pause-resume; enter-camera <=> root.mirv-enter-camera;
                    add-keyframe <=> root.mirv-add-keyframe; play-campath <=> root.mirv-play-campath;
                    draw-campath <=> root.mirv-draw-campath;
                    start-recording <=> root.mirv-start-recording; stop-recording <=> root.mirv-stop-recording;
                    print-keyframes <=> root.mirv-print-keyframes; save-campath <=> root.mirv-save-campath;
                    execute-director-action <=> root.mirv-execute-director-action;
                    overlay-panel-toggle <=> root.mirv-overlay-panel-toggle;
                }

                Tf2Button {
                    height: 34px; label-font-size: 13px;
                    text: (root.recording-settings-section == 5 ? "-  " : "+  ") + "CUSTOM RESOURCES";
                    tone: root.recording-settings-section == 5 ? Tf2Colors.gold : Tf2Colors.neutral;
                    hover-tone: root.recording-settings-section == 5 ? Tf2Colors.gold-hover : Tf2Colors.border-bright;
                    pressed-tone: root.recording-settings-section == 5 ? Tf2Colors.gold-pressed : Tf2Colors.border;
                    clicked => { root.recording-settings-section = root.recording-settings-section == 5 ? -1 : 5; }
                }
                if root.recording-settings-section == 5 : Tf2Panel {
                    height: 44px;
                    HorizontalLayout {
                        padding: 5px; spacing: 6px;
                        Tf2LineEdit { text <=> root.custom-resources; }
                        Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "ADD VPK"; clicked => { root.choose-custom-resources("files"); } }
                        Tf2Button { width: 82px; height: 30px; label-font-size: 12px; text: "FOLDER"; clicked => { root.choose-custom-resources("folder"); } }
                        Tf2Button { width: 70px; height: 30px; label-font-size: 12px; text: "CLEAR"; clicked => { root.custom-resources = ""; } }
                    }
                }

            }
        }

        if root.selected-page == 3 : VerticalLayout {
            x: 0px; y: root.compact ? (root.compact-nav-open ? 112px : 64px) : 118px; width: root.width; height: root.height - self.y;
            padding: root.compact ? 9px : 14px; spacing: root.compact ? 5px : 8px;
            HorizontalLayout {
                height: root.compact ? 24px : 34px;
                Tf2Heading { text: "SESSION LOGS"; font-size: root.compact ? 15px : 20px; }
                Rectangle { horizontal-stretch: 1; }
                Tf2Button { width: root.compact ? 130px : 170px; height: root.compact ? 30px : 36px; text: "OPEN LOG FOLDER"; clicked => { root.view-recording-logs(); } }
            }
            HorizontalLayout {
                spacing: root.compact ? 5px : 9px;
                Tf2Panel {
                    width: root.compact ? 31% : 29%;
                    VerticalLayout {
                        padding: root.compact ? 7px : 10px; spacing: 6px;
                        Tf2Heading { height: 22px; text: "RECENT SESSIONS"; font-size: root.compact ? 13px : 17px; }
                        Rectangle { height: 72px; background: Tf2Colors.gold; border-width: 1px; border-color: Tf2Colors.border-bright; VerticalLayout { padding: 7px; spacing: 2px; Tf2Body { text: "CURRENT SESSION"; } Tf2Body { text: root.status-text; color: Tf2Colors.cream; font-size: 12px; wrap: word-wrap; vertical-stretch: 1; vertical-alignment: center; } } }
                        Tf2Body { text: "Parser, analyzer, preview, and HLAE events appear in the batch log."; color: Tf2Colors.muted; wrap: word-wrap; vertical-alignment: top; }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                Tf2Panel { VerticalLayout { padding: root.compact ? 7px : 10px; spacing: 6px; Tf2Heading { height: 22px; text: "BATCH LOG"; font-size: root.compact ? 13px : 17px; } AutoScrollLog { log-text: root.log-text; vertical-stretch: 1; } } }
            }
            HorizontalLayout { height: 44px; spacing: 12px; Tf2Body { width: 50%; text: root.status-text; color: #8ab3cd; font-size: root.compact ? 11px : 12px; wrap: word-wrap; vertical-alignment: center; } Tf2Body { width: 50%; text: root.resource-plan-text; color: Tf2Colors.muted; font-size: root.compact ? 11px : 12px; wrap: word-wrap; horizontal-alignment: right; vertical-alignment: center; } }
        }

        if root.selected-page == 4 : VerticalLayout {
            x: 0px; y: root.compact ? (root.compact-nav-open ? 112px : 64px) : 118px; width: root.width; height: root.height - self.y;
            padding: root.compact ? 9px : 14px; spacing: 8px;
            HorizontalLayout { height: root.compact ? 50px : 38px; Tf2Heading { text: "CANDIDATE DETAILS"; font-size: root.compact ? 14px : 18px; } Rectangle { horizontal-stretch: 1; } Tf2Button { width: root.compact ? 160px : 190px; label-font-size: root.compact ? 13px : 15px; text: "BACK TO CANDIDATES"; clicked => { root.selected-page = 1; } } }
            Tf2Panel {
                ScrollView {
                    x: 8px; y: 8px; width: parent.width - 16px; height: parent.height - 16px;
                    vertical-scrollbar-policy: as-needed; horizontal-scrollbar-policy: always-off;
                    viewport-width: self.width;
                    viewport-height: detail-content.height + 16px;
                    detail-content := VerticalLayout {
                        x: 8px; y: 8px; width: parent.width - 28px; height: self.preferred-height; spacing: 8px;
                        if !root.compact : HorizontalLayout {
                            height: 100px; spacing: 8px;
                            if root.candidate-detail-has-player : CandidateDetailCard { heading: "PLAYER"; value: root.candidate-detail-player; supporting-text: root.candidate-detail-player-meta; }
                            if root.candidate-detail-has-map : CandidateDetailCard { heading: "MAP"; value: root.candidate-detail-map; supporting-text: root.candidate-detail-map-meta; }
                            if root.candidate-detail-has-demo : CandidateDetailCard { heading: "SOURCE DEMO"; value: root.candidate-detail-demo; supporting-text: root.candidate-detail-demo-meta; }
                            CandidateDetailCard { heading: "CANDIDATE SCORE"; value: root.candidate-detail-score; supporting-text: root.candidate-detail-score-meta; }
                        }
                        if root.compact : VerticalLayout {
                            height: self.preferred-height; spacing: 6px;
                            if root.candidate-detail-has-player : CandidateDetailCard { height: 84px; heading: "PLAYER"; value: root.candidate-detail-player; supporting-text: root.candidate-detail-player-meta; }
                            if root.candidate-detail-has-map : CandidateDetailCard { height: 84px; heading: "MAP"; value: root.candidate-detail-map; supporting-text: root.candidate-detail-map-meta; }
                            if root.candidate-detail-has-demo : CandidateDetailCard { height: 84px; heading: "SOURCE DEMO"; value: root.candidate-detail-demo; supporting-text: root.candidate-detail-demo-meta; }
                            CandidateDetailCard { height: 84px; heading: "CANDIDATE SCORE"; value: root.candidate-detail-score; supporting-text: root.candidate-detail-score-meta; }
                        }
                        if root.candidate-detail-has-summary : CandidateDetailSection { heading: "WHAT HAPPENS IN THIS CLIP"; body: root.candidate-detail-summary; section-floor-height: 92px; }
                        if root.candidate-detail-has-kills : CandidateDetailSection { heading: "KILL-BY-KILL"; body: root.candidate-detail-kills; section-floor-height: 92px; }
                        if root.candidate-detail-has-score-breakdown : CandidateDetailSection { heading: "WHY IT RECEIVED THIS SCORE"; body: root.candidate-detail-score-breakdown; section-floor-height: 110px; }
                        if root.candidate-detail-has-tags : CandidateDetailSection { heading: "TAG BREAKDOWN BY TICK"; body: root.candidate-detail-tags; section-floor-height: 72px; }
                    }
                }
            }
        }

    }
}

export struct CueRow {
    tick: int,
    position: float,
    label: string,
    tags: string,
    victims: string,
}

global Colors {
    in property <brush> app: #181918;
    in property <brush> header: #141514;
    in property <brush> panel: #24231f;
    in property <brush> panel-alt: #1d1d1b;
    in property <brush> row: #2b2b28;
    in property <brush> border: #514b40;
    in property <brush> cream: #decba9;
    in property <brush> muted: #a69882;
    in property <brush> dim: #756d60;
    in property <brush> blue: #2a4558;
    in property <brush> blue-text: #8ab3cd;
    in property <brush> gold: #a26614;
    in property <brush> green: #72b87a;
}

component Panel inherits Rectangle {
    background: Colors.panel;
    border-width: 1px;
    border-color: Colors.border;
}

component Heading inherits Text {
    color: Colors.cream;
    font-size: 18px;
    font-weight: 700;
    vertical-alignment: center;
}

component Caption inherits Text {
    color: Colors.muted;
    font-size: 12px;
    vertical-alignment: center;
}

export component DirectorWindow inherits Window {
    title: "TF2 MIRV Director";
    preferred-width: 1040px;
    preferred-height: 650px;
    min-width: 760px;
    min-height: 520px;
    background: Colors.app;

    in property <string> candidate-id;
    in property <string> demo-file;
    in property <string> map-name;
    in property <int> start-tick;
    in property <int> end-tick;
    in property <string> output-directory;
    in property <string> campath-file;
    in property <string> whole-tags;
    in property <bool> bridge-ready;
    in property <[CueRow]> cues;

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        Rectangle {
            height: 54px;
            background: Colors.header;
            border-width: 1px;
            border-color: Colors.border;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Heading { text: "TF2 MIRV DIRECTOR"; }
                Caption { text: "/  CAMPATH SHOT PLANNER"; }
                Rectangle { horizontal-stretch: 1; background: #00000000; }
                Text {
                    text: root.bridge-ready ? "LIVE BRIDGE: CONNECTED" : "CONTROL: EXISTING MIRV HOTKEYS";
                    color: root.bridge-ready ? Colors.green : Colors.blue-text;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        Panel {
            height: 76px;
            HorizontalLayout {
                padding: 12px;
                spacing: 24px;
                VerticalLayout { spacing: 2px; Caption { text: "CANDIDATE"; } Text { text: root.candidate-id; color: Colors.cream; font-size: 15px; } }
                VerticalLayout { spacing: 2px; Caption { text: "DEMO"; } Text { text: root.demo-file; color: Colors.cream; font-size: 15px; overflow: elide; } }
                VerticalLayout { spacing: 2px; Caption { text: "MAP"; } Text { text: root.map-name; color: Colors.cream; font-size: 15px; } }
                VerticalLayout { spacing: 2px; Caption { text: "WINDOW"; } Text { text: "TICK " + root.start-tick + "  →  " + root.end-tick; color: Colors.cream; font-size: 15px; } }
            }
        }

        Panel {
            height: 116px;
            VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Heading { height: 22px; text: "CANDIDATE TIMELINE"; font-size: 15px; }
                Rectangle {
                    height: 42px;
                    background: Colors.panel-alt;
                    border-width: 1px;
                    border-color: Colors.border;
                    Rectangle { x: 12px; y: 20px; width: parent.width - 24px; height: 2px; background: Colors.dim; }
                    Text { x: 8px; y: 25px; text: "START"; color: Colors.muted; font-size: 10px; }
                    Text { x: parent.width - 36px; y: 25px; text: "END"; color: Colors.muted; font-size: 10px; }
                    for cue in root.cues : Rectangle {
                        x: 12px + cue.position * (parent.width - 24px);
                        y: 8px;
                        width: 3px;
                        height: 25px;
                        background: Colors.gold;
                        Text { x: -24px; y: -7px; width: 52px; text: cue.tick; color: Colors.cream; font-size: 9px; horizontal-alignment: center; }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;

            Panel {
                horizontal-stretch: 3;
                VerticalLayout {
                    padding: 12px;
                    spacing: 7px;
                    Heading { height: 24px; text: "SHOT CUES"; font-size: 15px; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 5px;
                            for cue[index] in root.cues : Rectangle {
                                height: cue.victims == "" ? 58px : 76px;
                                background: index % 2 == 0 ? Colors.row : Colors.panel-alt;
                                border-width: 1px;
                                border-color: index == 0 ? Colors.blue : Colors.border;
                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    HorizontalLayout {
                                        height: 20px;
                                        Text { text: cue.label; color: Colors.blue-text; font-size: 13px; font-weight: 700; }
                                        Rectangle { horizontal-stretch: 1; background: #00000000; }
                                        Text { text: "TICK " + cue.tick; color: Colors.cream; font-size: 12px; }
                                    }
                                    Text { text: cue.tags; color: Colors.cream; font-size: 12px; overflow: elide; }
                                    if cue.victims != "" : Text { text: "VICTIMS  " + cue.victims; color: Colors.muted; font-size: 11px; overflow: elide; }
                                }
                            }
                        }
                    }
                }
            }

            Panel {
                horizontal-stretch: 2;
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    Heading { height: 24px; text: "CAMPATH WORKFLOW"; font-size: 15px; }
                    Text { height: 38px; text: "1   Use MIRV camera and compose the opening shot."; color: Colors.cream; font-size: 13px; wrap: word-wrap; }
                    Text { height: 38px; text: "2   Add a keyframe, then advance demo time."; color: Colors.cream; font-size: 13px; wrap: word-wrap; }
                    Text { height: 38px; text: "3   Frame each cue and add or replace its key."; color: Colors.cream; font-size: 13px; wrap: word-wrap; }
                    Text { height: 38px; text: "4   Safe restart, preview the path, then revise."; color: Colors.cream; font-size: 13px; wrap: word-wrap; }
                    Text { height: 38px; text: "5   Record through the helper: resume → start → stop."; color: Colors.cream; font-size: 13px; wrap: word-wrap; }
                    Rectangle { height: 1px; background: Colors.border; }
                    Caption { height: 18px; text: "WHOLE CANDIDATE"; }
                    Text { height: 36px; text: root.whole-tags == "" ? "No whole-candidate tags" : root.whole-tags; color: Colors.cream; font-size: 12px; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; background: #00000000; }
                    Caption { height: 18px; text: "CAMPATH FILE"; }
                    Text { height: 34px; text: root.campath-file; color: Colors.blue-text; font-size: 11px; wrap: word-wrap; }
                }
            }
        }

        Caption {
            height: 28px;
            text: "OUTPUT  " + root.output-directory;
            overflow: elide;
        }
    }
}
